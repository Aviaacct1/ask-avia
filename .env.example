# ask-avia - environment variable NAMES only. No values, ever.
#
# Copy to .env on the host and fill in. .env is gitignored and must stay that way.
# Secrets live in the environment plus one password-manager entry, and nowhere else.
# Never paste a placeholder such as <token> into a command: on 8 August that literal
# string was set as an environment variable and the failure surfaced much later.

# The single data root. E:\Avia on the workstation, C:\Avia on the Dev PC.
# config.py resolves every store from this, so a new host changes this one variable
# and no code.
AVIA_LOCAL_CACHE=

# Optional. Bind one store explicitly instead of landmark discovery under the data
# root. Use while the harvest is rebuilding, to pin the service to a store you know is
# not being written.
ASKAVIA_STORE_PATH=

# Bearer token every MCP caller must present. The service FAILS CLOSED without it.
ASKAVIA_AUTH_TOKEN=

# Service identity.
ASKAVIA_PORT=8040
ASKAVIA_HOSTNAME=

# Egnyte, for get_source locators and file_to_project writes.
ASKAVIA_EGNYTE_DOMAIN=
ASKAVIA_EGNYTE_TOKEN=

# Optional overrides. Default to <data root>\ask-avia\audit and \staging.
ASKAVIA_AUDIT_DIR=
ASKAVIA_STAGING_DIR=
